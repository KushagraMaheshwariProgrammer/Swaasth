{
  "name": "medbill-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:locations && vite",
    "sync:locations": "node scripts/sync-locations.mjs",
    "sync:firebase": "cp google-services.json android/app/google-services.json",
    "build": "npm run sync:locations && npm run sync:firebase && npm run native:api-url && env -u VITE_API_BASE vite build && npx cap sync android",
    "build:emulator": "npm run sync:locations && npm run sync:firebase && SWAASTH_BUILD_TARGET=emulator npm run native:api-url && VITE_API_BASE=http://10.0.2.2:8000 vite build && npx cap sync android",
    "preview": "vite preview",
    "native:api-url": "node scripts/sync-native-api-url.mjs",
    "cap:sync": "npm run sync:firebase && npm run native:api-url && env -u VITE_API_BASE vite build && npx cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "lint": "eslint src"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "vite": "^7.1.12"
  }
}
