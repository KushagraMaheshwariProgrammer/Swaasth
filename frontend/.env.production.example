# Production API URL — required before building a release APK.
# 1. Deploy backend (see render.yaml in repo root).
# 2. Copy this file:  cp .env.production.example .env.production
# 3. Set your live HTTPS URL below (no trailing slash).
# 4. From frontend/:  npm run build:release
VITE_API_BASE=https://your-backend.onrender.com
