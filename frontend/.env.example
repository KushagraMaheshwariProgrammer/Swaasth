# Web dev: leave VITE_API_BASE unset (uses Vite proxy).
#
# Android emulator workflow (from repo root Swaasth/):
#   1. Start backend:  cd backend && ./run_dev.sh
#   2. Build + sync:   npm run build
#      (or after code changes; sync only: npm run cap:sync)
#   3. Open frontend/android in Android Studio and run on emulator
#
# VITE_API_BASE=http://127.0.0.1:8000

# Firebase config is read from frontend/google-services.json.
# Optional overrides for the web app (same Firebase project):
# VITE_FIREBASE_APP_ID=1:384794855513:web:4dd4188fef420f1434c948
# VITE_FIREBASE_MEASUREMENT_ID=G-CK6DZ9FQC9
