# Copy to frontend/.env (gitignored):  cp .env.example .env
# Or from repo root:  npm run setup:env
#
# ── Shared config (already in the repo — no .env needed) ─────────────────────
# Firebase client config is read from frontend/google-services.json (committed).
# Web app ID / Analytics IDs have defaults in src/firebaseConfig.js.
#
# ── Optional overrides (uncomment only if you need them) ───────────────────

# Web dev: leave unset — Vite proxies /api to the backend on port 8000.
# VITE_API_BASE=http://127.0.0.1:8000

# Android emulator: backend must be reachable from the emulator.
# VITE_API_BASE=http://10.0.2.2:8000

# Rare: override web Firebase app / Analytics IDs (defaults are in firebaseConfig.js).
# VITE_FIREBASE_APP_ID=1:384794855513:web:4dd4188fef420f1434c948
# VITE_FIREBASE_MEASUREMENT_ID=G-CK6DZ9FQC9
