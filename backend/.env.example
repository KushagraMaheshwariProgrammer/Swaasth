# Copy to backend/.env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: path to NPPA ceiling price list CSV (default: backend/data/NPPA_Price_List_03-06-2025.csv)
# NPPA_DATASET_PATH=
# Optional: path to AZ medicines CSV for brand-to-generic resolution
# AZ_MEDICINES_DATASET_PATH=
# Allowed markup above NPPA ceiling before flagging (default 0.0 = strict)
# PHARMA_PRICE_TOLERANCE=0.0
