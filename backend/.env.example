# Copy to backend/.env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: path to primary indian_pharmaceutical_products.csv
# PHARMA_DATASET_PATH=
# Optional: path to backup az_medicines_india.csv (used when primary has no match)
# PHARMA_BACKUP_DATASET_PATH=
# Allowed markup above market MRP before flagging (default 0.15 = 15%)
# PHARMA_PRICE_TOLERANCE=0.15
