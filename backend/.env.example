# Copy to backend/.env (gitignored):  cp .env.example .env
# Or from repo root:  npm run setup:env
#
# ── Required (local only — never commit) ───────────────────────────────────
# Create a GPT-4o mini deployment in Azure AI Foundry, then copy its endpoint
# and key. Share credentials through a password manager, not GitHub.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# ── Environment ─────────────────────────────────────────────────────────────
# ENV=production
# PORT=8000

# ── CORS (comma-separated extra origins beyond defaults) ────────────────────
# Defaults include localhost, Capacitor, https://swaasth.in, https://www.swaasth.in
# CORS_ORIGINS=https://app.example.com

# ── Firebase Admin (optional — only if server-side auth is added) ───────────
# Download from Firebase Console → Project settings → Service accounts.
# For Railway, paste the full JSON as a single-line env var instead of a file:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── Optional dataset paths (defaults work for most dev setups) ─────────────
# NPPA_DATASET_PATH=
# AZ_MEDICINES_DATASET_PATH=
# PHARMA_PRICE_TOLERANCE=0.0
# JAN_AUSHADHI_DATASET_PATH=
# RESTRICTED_MEDICINES_DATASET_PATH=

# ── STG / RAG index configuration ───────────────────────────────────────────
# STG_INDEX_DIR=data/stg_index
# PRIMARY_GUIDELINES_INDEX_DIR=data/primary_guidelines_index
# STG_EMBED_MODEL=BAAI/bge-base-en-v1.5
# STG_RERANK_MODEL=BAAI/bge-reranker-base
# STG_RETRIEVAL_POOL_K=30
# STG_RERANK_TOP_K=12
# STG_MAX_CONTEXT_CHARS=16000
