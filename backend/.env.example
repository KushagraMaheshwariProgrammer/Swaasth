# Copy to backend/.env (gitignored):  cp .env.example .env
# Or from repo root:  npm run setup:env
#
# ── Required (local only — never commit) ───────────────────────────────────
# Get a key from https://console.groq.com/keys
# Share with teammates via a password manager or secure channel, not GitHub.
GROQ_API_KEY=

# ── Optional dataset paths (defaults work for most dev setups) ─────────────
# NPPA_DATASET_PATH=
# AZ_MEDICINES_DATASET_PATH=
# PHARMA_PRICE_TOLERANCE=0.0
# JAN_AUSHADHI_DATASET_PATH=

# ── Optional: Firebase Admin SDK (only if you add server-side Firebase) ────
# Download from Firebase Console → Project settings → Service accounts.
# Save as backend/firebase-service-account.json (gitignored).
# GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
